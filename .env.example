# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this file is committed and must only ever hold
# dummy values. Every variable the app reads must be listed here.
#
# Variables are added by the task that first uses them
# (see docs/specs/02-design.md, section 11, for the full list).

# Supabase project URL and public key (Project Settings > API Keys).
# Safe to expose: on its own the publishable key grants only what the
# database policies allow a signed-out visitor, which is nothing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# This app's own address: where Google sends people back to after sign-in.
# No trailing slash. Use the Vercel address in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TMDB "API Read Access Token" (themoviedb.org > Settings > API). It is the
# LONG one, starting "eyJ", not the short 32-character "API Key".
# SECRET, server only: no NEXT_PUBLIC_ prefix, so it never reaches a browser.
# Also set it in Vercel (Project > Settings > Environment Variables).
TMDB_API_READ_ACCESS_TOKEN=eyJxxxxxxxx.xxxxxxxx.xxxxxxxx

# --- Access-control tests only (npm run test:rls) ---------------------------
# These two go in .env.test.local, NOT .env.local, and only ever hold values
# for the quadrant-dev project.
#
# The secret key bypasses every database rule. Never commit it, never give it
# a NEXT_PUBLIC_ prefix, never paste it into chat.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Safety catch: the tests refuse to run unless NEXT_PUBLIC_SUPABASE_URL is
# this project, so they can never be pointed at production by accident.
RLS_TEST_PROJECT_REF=your-dev-project-ref
