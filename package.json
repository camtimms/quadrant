{
  "name": "quadrant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "db:push:prod": "supabase db push --remote=ykmpktjnqlmmirfciycq",
    "test:e2e": "playwright test",
    "refresh-titles": "tsx --conditions=react-server scripts/refresh-titles.ts",
    "refresh-titles:prod": "tsx --conditions=react-server scripts/refresh-titles.ts --prod",
    "backup": "tsx scripts/backup.ts",
    "backup:prod": "tsx scripts/backup.ts --prod"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
